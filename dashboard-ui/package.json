{
  "name": "janus-dashboard",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test scripts/deepmerge-security.test.mjs && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build && node scripts/prepare-build.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.20.5",
    "deepmerge": "file:vendor/deepmerge",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "overrides": {
    "deepmerge": "$deepmerge"
  }
}
